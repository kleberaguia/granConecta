{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=local nodemon --exec ts-node src/server.ts",
    "dev:server": "cross-env NODE_ENV=development node dist/server.js",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js -d src/config/data-source.ts",
    "typeorm:dev": "cross-env NODE_ENV=development node ./node_modules/typeorm/cli.js -d dist/config/data-source.js",
    "typeorm:dev:create": "cross-env NODE_ENV=development node ./node_modules/typeorm/cli.js -d dist/config/data-source.js migration:create dist/migrations/Init",
    "typeorm:dev:run": "cross-env NODE_ENV=development node ./node_modules/typeorm/cli.js -d dist/config/data-source.js migration:run",
    "typeorm:prod": "node ./node_modules/typeorm/cli.js -d dist/config/data-source.js",
    "migration:local": "cross-env NODE_ENV=local npm run typeorm -- migration:generate src/migrations/Migration",
    "migration:run:local": "cross-env NODE_ENV=local npm run typeorm -- migration:run",
    "migration:generate": "cross-env NODE_ENV=development npm run typeorm -- migration:generate src/migrations/Migration",
    "migration:run:dev": "cross-env NODE_ENV=development npm run typeorm:dev -- migration:run",
    "migration:run:prod": "cross-env NODE_ENV=production npm run typeorm:prod -- migration:run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "ejs": "^4.0.1",
    "express": "^5.1.0",
    "force": "^0.0.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.12.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11",
    "openai": "^6.22.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.3",
    "stripe": "^22.0.1",
    "twilio": "^6.0.0",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/pngjs": "^6.0.5",
    "@types/uuid": "^10.0.0",
    "copyfiles": "^2.4.1",
    "dotenv": "^17.2.3",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}