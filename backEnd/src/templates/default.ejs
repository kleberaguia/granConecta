<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= (landing.meta && landing.meta.metaTitle) ? landing.meta.metaTitle : (landing.hero && landing.hero.headline ?
      landing.hero.headline : "Minha Loja" ) %>
  </title>

  <style>
    :root {
      --primary: <%=(landing.theme && landing.theme.primaryColor) ? landing.theme.primaryColor: "#7c4dff" %>;
      --secondary: <%=(landing.theme && landing.theme.secondaryColor) ? landing.theme.secondaryColor: "#111111" %>;
      --bg: <%=(landing.theme && landing.theme.backgroundColor) ? landing.theme.backgroundColor: "#ffffff" %>;
      --text: #111111;
      --muted: #6b7280;
      --card: #ffffff;
      --line: #e5e7eb;
      --shadow: 0 10px 30px rgba(0, 0, 0, .08);
      --radius: 16px;
      --hero-overlay: .35;
      --btn-bg: var(--primary);
      --btn-text: #ffffff;
    }

    * {
      box-sizing: border-box
    }

    body {
      margin: 0;
      font-family: "<%= (landing.theme && landing.theme.fontFamily) ? landing.theme.fontFamily : " Inter" %>", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.4;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 20px
    }

    .grid {
      display: grid;
      gap: 18px
    }

    .grid-4 {
      grid-template-columns: repeat(4, 1fr)
    }

    .grid-3 {
      grid-template-columns: repeat(3, 1fr)
    }

    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .card .body {
      padding: 16px
    }

    .thumb {
      width: 100%;
      height: 160px;
      object-fit: cover;
      display: block
    }

    h1,
    h2,
    h3 {
      margin: 0
    }

    p {
      margin: 8px 0 0;
      color: var(--muted)
    }

    .price {
      font-weight: 900;
      margin-top: 10px
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 18px;
      border-radius: 12px;
      background: var(--btn-bg);
      color: var(--btn-text);
      text-decoration: none;
      font-weight: 800;
      border: 1px solid rgba(0, 0, 0, .06);
      margin-top: 14px;
    }

    .hero {
      position: relative;
      min-height: 520px;
      display: flex;
      align-items: center;
      padding: 110px 0 70px;
      background-size: cover;
      background-position: center;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(90deg,
          rgba(0, 0, 0, var(--hero-overlay)) 0%,
          rgba(0, 0, 0, .10) 55%,
          rgba(0, 0, 0, 0) 100%);
    }

    .hero-inner {
      position: relative;
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 28px;
      align-items: center
    }

    .hero h1 {
      color: #fff;
      font-size: clamp(34px, 4vw, 52px);
      line-height: 1.02
    }

    .hero p {
      color: rgba(255, 255, 255, .92)
    }

    .section {
      padding: 34px 0
    }

    .section-title {
      font-size: 18px;
      font-weight: 900;
      margin: 0 0 16px;
      text-align: center
    }

    @media (max-width:980px) {
      .hero-inner {
        grid-template-columns: 1fr
      }

      .grid-4 {
        grid-template-columns: repeat(2, 1fr)
      }

      .grid-3 {
        grid-template-columns: repeat(2, 1fr)
      }

      .hero {
        padding: 80px 0 60px
      }
    }

    @media (max-width:520px) {
      .grid-4 {
        grid-template-columns: 1fr
      }

      .grid-3 {
        grid-template-columns: 1fr
      }
    }
  </style>
</head>

<body>

  <section class="hero"
    style="background-image:url('<%= (landing.hero && landing.hero.backgroundImageUrl) ? landing.hero.backgroundImageUrl : "" %>')"
    data-edit="bg">
    <div class="container">
      <div class="hero-inner">
        <div>
          <h1 data-edit="text">
            <%= (landing.hero && landing.hero.headline) ? landing.hero.headline : "Minha Loja" %>
          </h1>
          <p data-edit="text">
            <%= (landing.hero && landing.hero.subheadline) ? landing.hero.subheadline : "" %>
          </p>
          <a class="btn" href="#cta" data-edit="text">
            <%= (landing.hero && landing.hero.ctaText) ? landing.hero.ctaText : "Saiba mais" %>
          </a>
        </div>
        <div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-4">
        <% (landing.cards || []).forEach(function(c){ %>
          <article class="card">
            <img class="thumb" src="<%= c.imageUrl || '' %>" alt="" data-edit="image" />
            <div class="body">
              <h3 data-edit="text">
                <%= c.title || '' %>
              </h3>
              <p data-edit="text">
                <%= c.description || '' %>
              </p>
            </div>
          </article>
          <% }) %>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title" data-edit="text">Benefícios</div>
      <div class="grid grid-3">
        <% (landing.benefits || []).forEach(function(b){ const item=(typeof b==="string" ) ? { title: b, description: ""
          } : (b || {}); %>
          <article class="card">
            <div class="body">
              <h3 data-edit="text">
                <%= (item.title && String(item.title).trim()) ? item.title : "Benefício" %>
              </h3>
              <% if (item.description) { %>
                <p data-edit="text">
                  <%= item.description %>
                </p>
                <% } %>
            </div>
          </article>
          <% }) %>
      </div>
    </div>
  </section>

  <% if (landing.meta && landing.meta.businessType==="product" ) { %>
    <section class="section" id="products">
      <div class="container">
        <div class="section-title" data-edit="text">Produtos</div>
        <div class="grid grid-3">
          <% (landing.products || []).forEach(function(p){ %>
            <article class="card">
              <img class="thumb" src="<%= p.imageUrl || '' %>" alt="" data-edit="image" />
              <div class="body">
                <h3 data-edit="text">
                  <%= p.name || '' %>
                </h3>
                <p data-edit="text">
                  <%= p.shortDescription || '' %>
                </p>
                <div class="price" data-edit="text">R$ <%= Number(p.price || 0).toFixed(2) %>
                </div>
                <a class="btn" href="#cta" data-edit="text">
                  <%= p.ctaText || "Comprar" %>
                </a>
              </div>
            </article>
            <% }) %>
        </div>
      </div>
    </section>
    <% } %>

      <section class="section">
        <div class="container">
          <div class="card">
            <div class="body" style="text-align:center">
              <h3 data-edit="text">
                <%= (landing.socialProof && landing.socialProof.proofText) ? landing.socialProof.proofText
                  : "Clientes satisfeitos." %>
              </h3>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-title" data-edit="text">Perguntas frequentes</div>
          <div class="grid grid-3">
            <% (landing.faq || []).forEach(function(f){ %>
              <article class="card">
                <div class="body">
                  <h3 data-edit="text">
                    <%= f.question || "" %>
                  </h3>
                  <p data-edit="text">
                    <%= f.answer || "" %>
                  </p>
                </div>
              </article>
              <% }) %>
          </div>
        </div>
      </section>

      <section class="hero" id="cta" style="min-height:auto;padding:70px 0;background-image:none;">
        <div class="container" style="position:relative;text-align:center">
          <h2 style="margin:0 0 10px;color:#111" data-edit="text">Pronto para dar o próximo passo?</h2>
          <a class="btn" href="#top" data-edit="text">
            <%= (landing.hero && landing.hero.ctaText) ? landing.hero.ctaText : "Falar" %>
          </a>
        </div>
      </section>

      <div style="text-align:center;padding:26px 20px;color:#6b7280">
        © <%= new Date().getFullYear() %> - Todos os direitos reservados
      </div>

</body>

</html>